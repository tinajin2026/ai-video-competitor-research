  "narrative": {
    "northStar": "Factory 市场分析工作台",
    "overview": "黑色画布、骨白文字与暖灰细线组织可操作的数据和可连续阅读的研究。Geist 承担正文与标题，Geist Mono 承担数字、日期和图表读数；橙绿用于变化、选择与状态。图表、表格、来源和文字分析构成页面的主要视觉材料。\n\n本记录延续已确认的 Factory 世界，描述 `src/dashboard.css` 与 `src/research.css` 的实际实现。工作台采用紧凑层级，独立研究页增加标题、段落行距与章节间距，以容纳较长的中文分析。两种密度共用颜色、字体、边框、控件与数字语言；研究页的阅读字号是现有身份的扩展。",
    "keyCharacteristics": [
      "黑色画布、暖灰细线与中性操作控件。",
      "Geist 正文与 Geist Mono 数据，依靠字号与对齐组织层级。",
      "工作台密集比较，独立研究页顺序阅读并保留操作入口。",
      "桌面并列呈现，手机顺序阅读，宽表格在局部容器滚动。"
    ],
    "rules": [
      {
        "name": "The Data Color Rule",
        "body": "操作底色保持中性；橙绿服务于变化、选择、警示和焦点，不承担大面积装饰。",
        "section": "colors"
      },
      {
        "name": "The Evidence Rule",
        "body": "颜色与数值、文字或图例共同表达信息；未知值不可借颜色伪装成确定结果。",
        "section": "colors"
      },
      {
        "name": "The Quiet Hierarchy Rule",
        "body": "通过字号、对比和对齐区分层级；研究标题可以放大，数字不承担装饰性英雄标题。",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "数据容器默认与画布同色，用细边框和间距分组。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 使用黑色画布、暖灰分隔和骨白文字保持 Factory 的分析质感。",
      "Do 让数值、统计月份、范围与来源互相可追溯。",
      "Do 为连续研究正文保留较大的字号与足够行距。",
      "Do 保留键盘焦点、精确值入口、筛选结果和操作反馈。",
      "Do 在手机顺序排列长文与动作，宽表格保持局部滚动。"
    ],
    "donts": [
      "Don't 将未知值呈现为零，或将估算写成后台实测。",
      "Don't 用大面积强调色、投影或辉光替代数据层级。",
      "Don't 将工作台的小型元信息字号推广成长正文默认字号。",
      "Don't 把数据采集日期当作统计月份，或把空动态区表现成实时接入。"
    ]
  }
